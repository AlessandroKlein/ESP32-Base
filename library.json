{
  "name": "ESP32-Base",
  "version": "0.8.0",
  "description": "Librería base reutilizable para firmware ESP32 (PlatformIO + Arduino): runtime modular, gestión de configuración, red (WiFi/Ethernet), web local, almacenamiento NVS/histórico, alarmas, publicadores HTTP/MQTT e infraestructura de dominio.",
  "keywords": [
    "esp32",
    "base",
    "framework",
    "iot",
    "runtime",
    "scheduler",
    "config",
    "wifi",
    "ethernet",
    "web",
    "nvs",
    "alarms",
    "publishers",
    "mqtt"
  ],
  "license": "MIT",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "dependencies": {
    "bblanchon/ArduinoJson": "^6.21.5",
    "links2004/WebSockets": "^2.4.1",
    "knolleary/PubSubClient": "^2.8",
    "4-20ma/ModbusMaster": "^2.0.1",
    "jgromes/RadioLib": "^6.0.0",
    "adafruit/Adafruit MCP23017 Arduino Library": "^2.3.0",
    "adafruit/Adafruit PWM Servo Driver Library": "^3.0.0",
    "adafruit/Adafruit PCF8574": "^1.0.0",
    "td-er/SC16IS752": "^1.0.2",
    "maxgerhardt/SC18IS602B-arduino": "^1.0.0",
    "robtillaart/TCA9548": "^0.3.2",
    "robtillaart/ADS1X15": "^0.6.2"
  }
}